# Copy this file to .env and fill in real values

# Local MongoDB:
#   MONGO_URI=mongodb://127.0.0.1:27017/ecommerce
# MongoDB Atlas (cloud):
#   MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ecommerce?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true&serverSelectionTimeoutMS=2000&appName=mongosh+2.9.2

# Any long random string. Used to sign JWT auth tokens.
JWT_SECRET=47cfda378235658f8de2e5920a3976c0b24d5f82eb3ba3f3ae9bf99fc6357af6

# Port the API server listens on
PORT=5000
